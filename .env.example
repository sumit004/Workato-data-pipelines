# --- Workato (UI) ---
WORKATO_UI_URL=https://app.workato.com
# Folder id where test pipelines are created (the ?fid=... in the Assets URL; EH8 in the demo)
WORKATO_FOLDER_ID=
# Existing connection NAMES (as shown in the connection picker)
SOURCE_CONNECTION=EH8 ODP2 Connection 2026
# Object to extract (search text + the exact object label to tick)
SOURCE_SEARCH=2LIS_11_
SOURCE_OBJECT=Sales Document Header Data [Service = ZODP_11_VAHDR_1_SRV] [Delta = ABR]

# --- Destinations to test (comma separated: snowflake, bigquery, databricks) ---
DESTINATIONS=snowflake
SNOWFLAKE_CONNECTION=
BIGQUERY_CONNECTION=
DATABRICKS_CONNECTION=

# Pipeline frequency (minimum 15 minutes)
PIPELINE_EVERY_MINUTES=15
# Max minutes to wait for the first full load to finish
LOAD_TIMEOUT_MINUTES=20
# Keep the pipeline after the test (true/false). Default: stop + delete.
KEEP_PIPELINE=false
